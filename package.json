{
  "name": "notesflare",
  "version": "1.0.0",
  "description": "Thought capture with near-zero cognitive friction.",
  "main": "electron/dist/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "next dev frontend",
    "dev:electron": "wait-on http://127.0.0.1:3000 && tsc -p tsconfig.electron.json && electron . --no-sandbox",
    "build:frontend": "next build frontend",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:frontend && npm run build:electron",
    "start": "electron . --no-sandbox",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "./scripts/test-backend.sh",
    "test:frontend": "./scripts/test-frontend.sh",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:backend:watch": "cd backend && pytest-watch",
    "test:frontend:watch": "npx vitest --watch",
    "test:coverage": "npm run test:backend && npm run test:frontend && echo 'Coverage in coverage/'",
    "stabilisation": "python StabilisationModule/run_stabilisation_benchmark.py",
    "stabilisation:no-embeddings": "python StabilisationModule/run_stabilisation_benchmark.py --no-embeddings",
    "stabilisation:continuous": "python StabilisationModule/run_stabilisation_benchmark.py --input StabilisationModule/examples_1000_continuous_stream.json --output StabilisationModule/outputs/formatted_results_continuous.json --summary StabilisationModule/outputs/benchmark_summary_continuous.json --benchmark-db StabilisationModule/outputs/stabilisation_benchmark_continuous.db",
    "stabilisation:continuous:no-embeddings": "python StabilisationModule/run_stabilisation_benchmark.py --input StabilisationModule/examples_1000_continuous_stream.json --output StabilisationModule/outputs/formatted_results_continuous.json --summary StabilisationModule/outputs/benchmark_summary_continuous.json --benchmark-db StabilisationModule/outputs/stabilisation_benchmark_continuous.db --no-embeddings",
    "stabilisation:progressive": "python StabilisationModule/run_stabilisation_benchmark.py --input StabilisationModule/examples_1000_progressive_usage.json --output StabilisationModule/outputs/formatted_results_progressive_usage.json --summary StabilisationModule/outputs/benchmark_summary_progressive_usage.json --benchmark-db StabilisationModule/outputs/stabilisation_benchmark_progressive_usage.db --simulate-decisions --reset-progressive-profile --study-old-data",
    "stabilisation:progressive:no-embeddings": "python StabilisationModule/run_stabilisation_benchmark.py --input StabilisationModule/examples_1000_progressive_usage.json --output StabilisationModule/outputs/formatted_results_progressive_usage.json --summary StabilisationModule/outputs/benchmark_summary_progressive_usage.json --benchmark-db StabilisationModule/outputs/stabilisation_benchmark_progressive_usage.db --simulate-decisions --reset-progressive-profile --study-old-data --no-embeddings",
    "stabilisation:generate-progressive": "python StabilisationModule/generate_progressive_usage_examples.py",
    "stabilisation:all": "npm run stabilisation && npm run stabilisation:continuous && npm run stabilisation:progressive",
    "stabilisation:all:no-embeddings": "npm run stabilisation:no-embeddings && npm run stabilisation:continuous:no-embeddings && npm run stabilisation:progressive:no-embeddings"
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "happy-dom": "^14.12.0",
    "jsdom": "^24.1.0",
    "msw": "^2.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  }
}
