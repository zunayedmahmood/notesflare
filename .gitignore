# ============================================================
# NotesFlare — .gitignore
# Stack: Python/FastAPI · Next.js · Electron · Vitest · SQLite
# ============================================================

# ────────────────────────────────────────────────
# Dependencies
# ────────────────────────────────────────────────
node_modules/
.venv/
venv/
env/

# ────────────────────────────────────────────────
# Build & Compile Outputs
# ────────────────────────────────────────────────
# Next.js
frontend/.next/
frontend/out/

# Electron
electron/dist/
dist/
dist-electron/
out/

# TypeScript build info
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ────────────────────────────────────────────────
# Coverage & Test Artifacts
# ────────────────────────────────────────────────
# Python coverage
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/

# JS/TS coverage
coverage-ts/
lcov.info
*.lcov

# Test results & reports
test-results/
playwright-report/
junit.xml
*.junit.xml
vitest-results/

# pytest cache
.pytest_cache/

# ────────────────────────────────────────────────
# Python Bytecode & Caches
# ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Egg / dist / packaging
*.egg-info/
dist/
build/
*.egg
.eggs/

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / linting caches
.ruff_cache/

# ────────────────────────────────────────────────
# Environment & Secrets
# ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ────────────────────────────────────────────────
# Database (user data — never commit)
# ────────────────────────────────────────────────
storage/*.db
storage/*.db-shm
storage/*.db-wal
*.sqlite
*.sqlite3

# ────────────────────────────────────────────────
# Logs
# ────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ────────────────────────────────────────────────
# OS-generated Files
# ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ────────────────────────────────────────────────
# Editor & IDE
# ────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────
.cache/
.parcel-cache/
*.pem
*.key
test.md
